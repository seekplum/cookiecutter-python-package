#!/bin/bash
cd "$(dirname "$0")/.."
docker buildx build \
	--build-arg BUILDKIT_INLINE_CACHE=1 \
	--build-arg BUILD_ID="${JENKINS_BUILD_ID}" \
	--build-arg BUILD_VERSION="{% raw %}${{% endraw %}{{ project_slug.upper() }}_BUILD_TAG{% raw %}}{% endraw %}" \
    --file ./docker/Dockerfile \
    --load \
    --network=host \
    --tag {{ project_name }} .
